@model FlowDesk.ViewModels.Analyst.AnalystInboxViewModel
@using FlowDesk.Models

@{
    ViewData["Title"] = "Analist Dashboard";

    var workItems = Model?.WorkItems
        ?? new List<FlowDesk.ViewModels.Analyst.AnalystInboxItemViewModel>();
    var newRequestCount = workItems.Count(x => x.WorkflowStatus == WorkflowStatus.Submitted);
    var reviewingCount = workItems.Count(x => x.WorkflowStatus == WorkflowStatus.UnderAnalystReview);
    var returnedCount = Model?.ReturnedCount ?? 0;
    var waitingApprovalCount = workItems.Count(x => x.WorkflowStatus == WorkflowStatus.WaitingManagerApproval);
    var completedAnalysisCount = workItems.Count(x => x.WorkflowStatus == WorkflowStatus.Completed);
    var priorityRequests = workItems
        .OrderByDescending(x => x.Priority)
        .ThenByDescending(x => x.CreatedAt)
        .Take(8)
        .ToList();
}

<div class="container-fluid p-0">
    <div class="mb-4">
        <h2 class="dashboard-title">Analist</h2>
        <p class="dashboard-subtitle">Analiz kuyruğunu yönetin ve öncelikli talepleri takip edin.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <nav class="row g-3 mb-4" aria-label="Analist işlemleri">
        <div class="col-12 col-md-6 col-xl">
            <a asp-controller="Analyst" asp-action="Inbox" class="dashboard-nav-card">
                <span class="dashboard-nav-title">Gelen Talepler</span>
                <strong class="dashboard-nav-count">@newRequestCount</strong>
                <span class="dashboard-nav-description">İncelemeye başlanmamış yeni talepler.</span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <a asp-controller="Analyst" asp-action="Inbox" class="dashboard-nav-card">
                <span class="dashboard-nav-title">İncelemedeki Talepler</span>
                <strong class="dashboard-nav-count">@reviewingCount</strong>
                <span class="dashboard-nav-description">Analizi devam eden talepler.</span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <a asp-controller="Analyst" asp-action="ReturnedRequests" class="dashboard-nav-card">
                <span class="dashboard-nav-title">Geri Gönderilen Talepler</span>
                <strong class="dashboard-nav-count">@returnedCount</strong>
                <span class="dashboard-nav-description">Yönetici notuyla analiste iade edilenler.</span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <div class="dashboard-nav-card dashboard-nav-card-disabled" aria-disabled="true">
                <span class="dashboard-nav-title">Yönetici Onayı Bekleyenler</span>
                <strong class="dashboard-nav-count">@waitingApprovalCount</strong>
                <span class="dashboard-nav-description">Ayrı liste ekranı henüz bulunmuyor.</span>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl">
            <div class="dashboard-nav-card dashboard-nav-card-disabled" aria-disabled="true">
                <span class="dashboard-nav-title">Tamamlanan Analizler</span>
                <strong class="dashboard-nav-count">@completedAnalysisCount</strong>
                <span class="dashboard-nav-description">Ayrı liste ekranı henüz bulunmuyor.</span>
            </div>
        </div>
    </nav>

    <section class="modern-card">
        <div class="modern-card-header">
            <div>
                <h3 class="modern-card-title">Öncelikli ve Son Gelen Talepler</h3>
                <p class="dashboard-section-note">Öncelik ve oluşturulma tarihine göre sıralanmıştır</p>
            </div>
        </div>

        @if (!priorityRequests.Any())
        {
            <div class="empty-state">
                <h4 class="empty-state-title">İncelenecek talep bulunmuyor</h4>
                <p class="empty-state-description">Yeni bir talep geldiğinde burada görüntülenecektir.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle">
                    <thead>
                        <tr>
                            <th>Talep No</th>
                            <th>Açıklama</th>
                            <th>Departman</th>
                            <th>Öncelik</th>
                            <th>Durum</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in priorityRequests)
                        {
                            string priorityText = item.Priority switch
                            {
                                RequestPriority.Low => "Düşük",
                                RequestPriority.Normal => "Normal",
                                RequestPriority.High => "Yüksek",
                                RequestPriority.Critical => "Kritik",
                                _ => item.Priority.ToString()
                            };

                            <tr>
                                <td class="fw-semibold">@item.RequestNumber</td>
                                <td class="dashboard-description-cell">@item.RequestDescription</td>
                                <td>@item.Department</td>
                                <td><span class="badge bg-light text-dark border">@priorityText</span></td>
                                <td>@item.CurrentStatus</td>
                                <td class="text-end">
                                    @if (item.WorkflowStatus == WorkflowStatus.Submitted)
                                    {
                                        <form asp-controller="Analyst"
                                              asp-action="StartReview"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary">İncelemeye Başla</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Analyst"
                                           asp-action="Review"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">İncelemeye Devam Et</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
