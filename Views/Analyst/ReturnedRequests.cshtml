@model IEnumerable<FlowDesk.Models.WorkItem>

@{
    ViewData["Title"] = "Yönetici Tarafından İade Edilenler";

    var requests = Model?.ToList()
        ?? new List<FlowDesk.Models.WorkItem>();
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"
                style="color: var(--primary-navy);">
                Yönetici Tarafından İade Edilenler
            </h3>

            <p class="text-muted mb-0">
                Departman yöneticisinin düzenleme yapılması için
                analiste geri gönderdiği talepler.
            </p>
        </div>

        <a asp-controller="Analyst"
           asp-action="Inbox"
           class="btn btn-outline-secondary">
            Gelen Kutusuna Dön
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                İade Edilen Talepler
            </h5>
        </div>

        <div class="card-body p-0">

            @if (!requests.Any())
            {
                <div class="text-center py-5">
                    <h5>İade edilmiş talep bulunmuyor</h5>

                    <p class="text-muted mb-0">
                        Yönetici tarafından geri gönderilen talepler
                        burada görüntülenecektir.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Talep No</th>
                                <th>Talep</th>
                                <th>Departman</th>
                                <th>Mevcut Statü</th>
                                <th>Yönetici Notu</th>
                                <th>Güncellenme Tarihi</th>
                                <th class="text-end pe-4">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in requests)
                            {
                                string description =
                                item.RequestDescription.Length > 80
                                ? item.RequestDescription[..80] + "..."
                                : item.RequestDescription;

                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @item.RequestNumber
                                    </td>

                                    <td style="min-width: 250px;">
                                        @description
                                    </td>

                                    <td>
                                        @item.Department
                                    </td>

                                    <td>
                                        <span class="badge bg-danger-subtle text-danger">
                                            Analiste İade Edildi
                                        </span>
                                    </td>

                                    <td style="min-width: 220px;">
                                        @if (string.IsNullOrWhiteSpace(item.ManagerNote))
                                        {
                                            <span class="text-muted">
                                                Not belirtilmedi
                                            </span>
                                        }
                                        else
                                        {
                                            @item.ManagerNote
                                        }
                                </td>

                                <td class="text-nowrap">
                                    @(item.UpdatedAt?.ToLocalTime()
                                                                    .ToString("dd.MM.yyyy HH:mm")
                                                                    ?? "-")
                            </td>

                                    <td class="text-end pe-4">
                                        <a asp-controller="Analyst"
                                           asp-action="Review"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-primary">
                                            Talebi Düzenle
                                        </a>
                                    </td>
                                </tr>
                                                }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>