@model FlowDesk.ViewModels.Account.ForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>FlowDesk | Şifremi Unuttum</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>
<body>
    <main class="login-page">
        <section class="login-card">

            <div class="login-brand">
                <div class="brand-icon">F</div>

                <div>
                    <h1>FlowDesk</h1>
                    <p>Talep ve iş akışı yönetimi</p>
                </div>
            </div>

            <div class="login-header">
                <h2>Şifrenizi sıfırlayın</h2>
                <p>
                    Hesabınıza ait e-posta adresini girin.
                    Size 6 haneli bir doğrulama kodu göndereceğiz.
                </p>
            </div>

            <form asp-controller="Account"
                  asp-action="ForgotPassword"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="mb-4">
                    <label asp-for="Email"
                           class="form-label">
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="ornek@gmail.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-primary login-button">
                    Doğrulama Kodu Gönder
                </button>

                <div class="text-center mt-4">
                    <a asp-controller="Account"
                       asp-action="Login">
                        Giriş sayfasına dön
                    </a>
                </div>
            </form>

        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>