@model FlowDesk.Models.WorkItem

@{ ViewData["Title"] = "Talebi Sil"; }

<div class="container-fluid p-0">
    <header class="page-header">
        <div>
            <h1>Talebi Sil</h1>
            <p class="page-description">Silme i&#351;lemini onaylamadan &#246;nce talep bilgilerini kontrol edin.</p>
        </div>
    </header>
    <section class="modern-card mx-auto" style="max-width: 760px;" aria-labelledby="delete-title">
        <div class="modern-card-header"><h2 id="delete-title" class="modern-card-title text-danger">Kal&#305;c&#305; silme onay&#305;</h2></div>
        <div class="p-4">
            <div class="alert alert-warning" role="alert">Bu i&#351;lem geri al&#305;namaz. Yaln&#305;zca silmek istedi&#287;iniz taleple devam edin.</div>
            <div class="detail-grid mb-4">
                <div class="detail-item"><div class="detail-label">Talep No</div><div class="detail-value">@Model.RequestNumber</div></div>
                <div class="detail-item"><div class="detail-label">Departman</div><div class="detail-value">@Model.Department</div></div>
                <div class="detail-item"><div class="detail-label">&#214;ncelik</div><div class="detail-value"><partial name="_PriorityBadge" model="Model.Priority" /></div></div>
            </div>
            <div class="detail-note mb-4">@Model.RequestDescription</div>
            <form asp-controller="ProjectManager" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-secondary">Vazge&#231;</a>
                    <button type="submit" class="btn btn-danger">Talebi Kal&#305;c&#305; Olarak Sil</button>
                </div>
            </form>
        </div>
    </section>
</div>
