@model IEnumerable<FlowDesk.Models.WorkItem>
@using FlowDesk.Models

@{
    ViewData["Title"] = "İş Birimi Dashboard";

    var workItems = Model?.ToList() ?? new List<WorkItem>();
    var totalCount = workItems.Count;
    var inProgressCount = workItems.Count(x =>
        x.WorkflowStatus == WorkflowStatus.Approved ||
        x.WorkflowStatus == WorkflowStatus.Assigned ||
        x.WorkflowStatus == WorkflowStatus.InProgress);
    var completedCount = workItems.Count(x =>
        x.WorkflowStatus == WorkflowStatus.Completed);
    var recentRequests = workItems
        .OrderByDescending(x => x.CreatedAt)
        .Take(6)
        .ToList();
}

<div class="container-fluid p-0">
    <div class="mb-4">
        <h2 class="dashboard-title">İş Birimi</h2>
        <p class="dashboard-subtitle">Yeni talep oluşturun ve mevcut taleplerinizin durumunu takip edin.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <nav class="row g-3 mb-4" aria-label="İş Birimi işlemleri">
        <div class="col-12 col-md-6 col-xl-3">
            <a asp-controller="ProjectManager"
               asp-action="Create"
               class="dashboard-nav-card dashboard-nav-card-primary">
                <span class="dashboard-nav-title">Yeni Talep Oluştur</span>
                <span class="dashboard-nav-description">Yeni bir iş talebini sisteme kaydedin.</span>
                <span class="dashboard-nav-action">Talep oluştur</span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <a asp-controller="ProjectManager"
               asp-action="Index"
               class="dashboard-nav-card">
                <span class="dashboard-nav-title">Taleplerim</span>
                <strong class="dashboard-nav-count">@totalCount</strong>
                <span class="dashboard-nav-description">Oluşturduğunuz tüm talepleri görüntüleyin.</span>
            </a>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="dashboard-nav-card dashboard-nav-card-disabled" aria-disabled="true">
                <span class="dashboard-nav-title">Devam Eden Talepler</span>
                <strong class="dashboard-nav-count">@inProgressCount</strong>
                <span class="dashboard-nav-description">Ayrı liste ekranı henüz bulunmuyor.</span>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="dashboard-nav-card dashboard-nav-card-disabled" aria-disabled="true">
                <span class="dashboard-nav-title">Tamamlanan Talepler</span>
                <strong class="dashboard-nav-count">@completedCount</strong>
                <span class="dashboard-nav-description">Ayrı liste ekranı henüz bulunmuyor.</span>
            </div>
        </div>
    </nav>

    <section class="modern-card">
        <div class="modern-card-header">
            <div>
                <h3 class="modern-card-title">Son Oluşturulan Talepler</h3>
                <p class="dashboard-section-note">En son oluşturduğunuz altı talep</p>
            </div>
        </div>

        @if (!recentRequests.Any())
        {
            <div class="empty-state">
                <h4 class="empty-state-title">Henüz talep bulunmuyor</h4>
                <p class="empty-state-description">İlk talebinizi oluşturarak iş akışını başlatabilirsiniz.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle">
                    <thead>
                        <tr>
                            <th>Talep No</th>
                            <th>Açıklama</th>
                            <th>Departman</th>
                            <th>Durum</th>
                            <th>Oluşturulma</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in recentRequests)
                        {
                            string statusText = item.WorkflowStatus switch
                            {
                                WorkflowStatus.Submitted => "Gönderildi",
                                WorkflowStatus.UnderAnalystReview => "Analizde",
                                WorkflowStatus.WaitingManagerApproval => "Yönetici Onayında",
                                WorkflowStatus.ReturnedToAnalyst => "Analiste İade",
                                WorkflowStatus.Approved => "Onaylandı",
                                WorkflowStatus.Assigned => "Atandı",
                                WorkflowStatus.InProgress => "Devam Ediyor",
                                WorkflowStatus.Completed => "Tamamlandı",
                                WorkflowStatus.Rejected => "Reddedildi",
                                _ => item.WorkflowStatus.ToString()
                            };

                            <tr>
                                <td class="fw-semibold">@item.RequestNumber</td>
                                <td class="dashboard-description-cell">@item.RequestDescription</td>
                                <td>@item.Department</td>
                                <td><span class="badge bg-light text-dark border">@statusText</span></td>
                                <td class="text-nowrap">@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="ProjectManager"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">Detay</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
