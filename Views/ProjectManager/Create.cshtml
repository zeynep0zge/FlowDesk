@model FlowDesk.Models.WorkItem

@{
    ViewData["Title"] = "Yeni Talep Oluştur";
}

<div class="container-fluid p-0">

    <!-- Sayfa başlığı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"
                style="color: var(--primary-navy);">
                Yeni Talep Oluştur
            </h3>

            <p class="text-muted mb-0"
               style="font-size: 0.9rem;">
                Sisteme yeni bir iş veya proje talebi eklemek için
                aşağıdaki formu doldurunuz.
            </p>
        </div>

        <a asp-controller="ProjectManager"
           asp-action="Index"
           class="btn btn-secondary py-2 px-3 d-flex align-items-center gap-2"
           style="font-size: 0.9rem;">

            <svg width="16"
                 height="16"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">

                <line x1="19"
                      y1="12"
                      x2="5"
                      y2="12">
                </line>

                <polyline points="12 19 5 12 12 5">
                </polyline>
            </svg>

            Taleplerime Dön
        </a>
    </div>

    <!-- Ortalanmış form alanı -->
    <div class="row">
        <div class="col-12 col-lg-10 mx-auto">

            <div class="form-card">

                <h5 class="form-title">
                    Talep Detayları
                </h5>

                <form asp-controller="ProjectManager"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- Genel doğrulama mesajları -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger border-0 shadow-sm mb-4"
                         style="
                            border-left: 4px solid var(--color-critical) !important;
                            background-color: var(--bg-critical);
                            color: var(--color-critical);
                            font-size: 0.9rem;">
                    </div>

                    <!-- Talep numarası ve departman -->
                    <div class="row g-3 mb-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="RequestNumber"
                                   class="form-label">
                                Talep Numarası
                            </label>

                            <input asp-for="RequestNumber"
                                   class="form-control"
                                   placeholder="Örn: TLP-2026-001" />

                            <span asp-validation-for="RequestNumber"
                                  class="text-danger"
                                  style="font-size: 0.8rem; font-weight: 500;">
                            </span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Department"
                                   class="form-label">
                                İlgili Departman
                            </label>

                            <select asp-for="Department"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(FlowDesk.Common.DepartmentOptions.All))"
                                    class="form-select">
                                <option value="">Departman seçiniz</option>
                            </select>

                            <span asp-validation-for="Department"
                                  class="text-danger"
                                  style="font-size: 0.8rem; font-weight: 500;">
                            </span>
                        </div>

                    </div>

                    <!-- Öncelik -->
                    <div class="mb-3">
                        <label asp-for="Priority"
                               class="form-label">
                            Öncelik Derecesi
                        </label>

                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<FlowDesk.Models.RequestPriority>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Priority"
                              class="text-danger"
                              style="font-size: 0.8rem; font-weight: 500;">
                        </span>
                    </div>

                    <!-- Talep açıklaması -->
                    <div class="mb-4">
                        <label asp-for="RequestDescription"
                               class="form-label">
                            Talep Açıklaması
                        </label>

                        <textarea asp-for="RequestDescription"
                                  class="form-control"
                                  rows="7"
                                  placeholder="İş talebinin detaylarını, hedeflerini ve gerekçelerini buraya yazınız."></textarea>

                        <span asp-validation-for="RequestDescription"
                              class="text-danger"
                              style="font-size: 0.8rem; font-weight: 500;">
                        </span>
                    </div>

                    <!-- Butonlar -->
                    <div class="d-flex justify-content-between align-items-center pt-2">

                        <a asp-controller="ProjectManager"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Geri Dön
                        </a>

                        <button type="submit"
                                class="btn btn-primary d-flex align-items-center gap-2">

                            <svg width="18"
                                 height="18"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z">
                                </path>

                                <polyline points="17 21 17 13 7 13 7 21">
                                </polyline>

                                <polyline points="7 3 7 8 15 8">
                                </polyline>
                            </svg>

                            Talebi Oluştur
                        </button>

                    </div>

                </form>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}