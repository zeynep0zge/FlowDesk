@model FlowDesk.Models.WorkItem

@{ ViewData["Title"] = "Yeni Talep Olu\u015ftur"; }

<div class="container-fluid p-0">
    <header class="page-header">
        <div>
            <h1>Yeni Talep Olu&#351;tur</h1>
            <p class="page-description">Talep numaras&#305; kay&#305;t s&#305;ras&#305;nda sistem taraf&#305;ndan otomatik olu&#351;turulur.</p>
        </div>
        <div class="page-actions"><a asp-action="Index" class="btn btn-secondary">Taleplerime d&#246;n</a></div>
    </header>

    <section class="form-card" aria-labelledby="create-form-title">
        <h2 id="create-form-title" class="form-title">Talep detaylar&#305;</h2>
        <form asp-controller="ProjectManager" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="alert alert-info" role="status">
                Kurumsal talep kodu <strong>TLP-GGAAYYYY-XXXX</strong> format&#305;nda otomatik atanacakt&#305;r.
            </div>

            <div class="mb-3">
                <label asp-for="RequestDescription" class="form-label"></label>
                <textarea asp-for="RequestDescription" class="form-control" rows="7" maxlength="2000" aria-required="true" placeholder="Talebin kapsam&#305;n&#305;, hedefini ve gerek&#231;esini a&#231;&#305;klay&#305;n."></textarea>
                <span asp-validation-for="RequestDescription" class="text-danger"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-7">
                    <label asp-for="Department" class="form-label"></label>
                    <select asp-for="Department" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(FlowDesk.Common.DepartmentOptions.All))" class="form-select" aria-required="true">
                        <option value="">Departman se&#231;iniz</option>
                    </select>
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority" asp-items="Html.GetEnumSelectList<FlowDesk.Models.RequestPriority>()" class="form-select"></select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
            </div>

            <div class="form-actions mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">Vazge&#231;</a>
                <button type="submit" class="btn btn-primary">Talebi Olu&#351;tur</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
