@model FlowDesk.Models.WorkItem

@{
    ViewData["Title"] = "Yeni Talep Oluştur";
}

<div class="container-fluid p-0">
    <!-- Header/Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--primary-navy);">Yeni Talep Oluştur</h3>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">
                Sisteme yeni bir iş veya proje talebi eklemek için aşağıdaki formu doldurunuz.
            </p>
        </div>
        <a asp-controller="ProjectManager"
           asp-action="Index"
           class="btn btn-secondary py-2 px-3 d-flex align-items-center gap-1"
           style="font-size: 0.9rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Taleplerime Dön
        </a>
    </div>

    <!-- Layout Grid -->
    <div class="row g-4">
        <!-- Form Column -->
        <div class="col-12 col-lg-8">
            <div class="form-card">
                <h5 class="form-title">Talep Detayları</h5>
                
                <form asp-controller="ProjectManager"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger border-0 shadow-sm mb-4"
                         style="border-left: 4px solid var(--color-critical) !important; background-color: var(--bg-critical); color: var(--color-critical); font-size: 0.9rem;">
                    </div>

                    <!-- Row 1: Talep No & Departman -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="RequestNumber" class="form-label">Talep Numarası</label>
                            <input asp-for="RequestNumber"
                                   class="form-control"
                                   placeholder="Örn: TLP-2026-001"
                                   required />
                            <span asp-validation-for="RequestNumber" class="text-danger" style="font-size: 0.8rem; font-weight: 500;"></span>
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label asp-for="Department" class="form-label">İlgili Departman</label>
                            <input asp-for="Department"
                                   class="form-control"
                                   placeholder="Örn: ATM Uygulamaları"
                                   required />
                            <span asp-validation-for="Department" class="text-danger" style="font-size: 0.8rem; font-weight: 500;"></span>
                        </div>
                    </div>

                    <!-- Row 2: Öncelik -->
                    <div class="mb-3">
                        <label asp-for="Priority" class="form-label">Öncelik Derecesi</label>
                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<FlowDesk.Models.RequestPriority>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Priority" class="text-danger" style="font-size: 0.8rem; font-weight: 500;"></span>
                    </div>

                    <!-- Row 3: Talep Açıklaması -->
                    <div class="mb-4">
                        <label asp-for="RequestDescription" class="form-label">Talep Açıklaması</label>
                        <textarea asp-for="RequestDescription"
                                  class="form-control"
                                  rows="6"
                                  placeholder="İş talebinizin detaylı analiz açıklamalarını, hedeflerini ve gerekçelerini buraya yazınız..."
                                  required></textarea>
                        <span asp-validation-for="RequestDescription" class="text-danger" style="font-size: 0.8rem; font-weight: 500;"></span>
                    </div>

                    <!-- Form Footer Buttons -->
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-controller="ProjectManager"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Geri Dön
                        </a>
                        <button type="submit" class="btn btn-primary d-flex align-items-center gap-1">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                            Talebi Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Workflow Help Column -->
        <div class="col-12 col-lg-4">
            <div class="form-card" style="height: 100%;">
                <h5 class="form-title" style="margin-bottom: 2rem;">İş Akış Süreci</h5>
                
                <div class="stepper">
                    <div class="step-item active">
                        <div class="step-circle">1</div>
                        <div class="step-content">
                            <h6 class="step-title">Talep Girişi</h6>
                            <p class="step-desc">Proje yöneticisi talebi oluşturur.</p>
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-circle">2</div>
                        <div class="step-content">
                            <h6 class="step-title">Analiz ve Atama</h6>
                            <p class="step-desc">Analist talebi inceler ve AI destekli atamaları yapar.</p>
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-circle">3</div>
                        <div class="step-content">
                            <h6 class="step-title">Yönetici Kontrolü</h6>
                            <p class="step-desc">Departman yöneticisi atamaları kontrol eder ve gerekirse düzenler.</p>
                        </div>
                    </div>
                    <div class="step-item">
                        <div class="step-circle">4</div>
                        <div class="step-content">
                            <h6 class="step-title">Otomatik Excel Aktarımı</h6>
                            <p class="step-desc">Onaylanan bilgiler sistem tarafından Excel raporuna aktarılır.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}