@model FlowDesk.Models.WorkItem

@{
    ViewData["Title"] = "Talebi Güncelle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">Talebi Güncelle</h3>
                </div>

                <div class="card-body">
                    <form asp-controller="ProjectManager"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequestNumber"
                                   class="form-label">
                            </label>

                            <input asp-for="RequestNumber"
                                   class="form-control" />

                            <span asp-validation-for="RequestNumber"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequestDescription"
                                   class="form-label">
                            </label>

                            <textarea asp-for="RequestDescription"
                                      class="form-control"
                                      rows="6">
                            </textarea>

                            <span asp-validation-for="RequestDescription"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Department"
                                   class="form-label">
                            </label>

                            <select asp-for="Department"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(FlowDesk.Common.DepartmentOptions.All))"
                                    class="form-select">
                                <option value="">Departman seçiniz</option>
                            </select>

                            <span asp-validation-for="Department"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Priority"
                                   class="form-label">
                            </label>

                            <select asp-for="Priority"
                                    asp-items="Html.GetEnumSelectList<FlowDesk.Models.RequestPriority>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Priority"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Geri Dön
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}