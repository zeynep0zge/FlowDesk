@model FlowDesk.Models.WorkflowStatus
@using FlowDesk.Models
@{
    string badgeClass = Model switch
    {
        WorkflowStatus.Submitted => "badge-status-submitted",
        WorkflowStatus.UnderAnalystReview => "badge-status-review",
        WorkflowStatus.WaitingManagerApproval => "badge-status-approval",
        WorkflowStatus.ReturnedToAnalyst => "badge-status-returned",
        WorkflowStatus.Approved => "badge-status-approved",
        WorkflowStatus.Assigned => "badge-status-assigned",
        WorkflowStatus.InProgress => "badge-status-progress",
        WorkflowStatus.Completed => "badge-status-completed",
        WorkflowStatus.Rejected => "badge-status-rejected",
        _ => "badge-status-neutral"
    };
    string description = WorkflowStatusDescriptions.GetDescription(Model);
}
<span class="badge-pill-custom @badgeClass">
    <span class="badge-dot" aria-hidden="true"></span>
    @description
</span>