@model FlowDesk.ViewModels.ErrorViewModel
@{ ViewData["Title"] = "Bir Hata Olu\u015ftu"; }

<div class="container-fluid p-0">
    <section class="modern-card mx-auto text-center" style="max-width: 640px;" aria-labelledby="error-title">
        <div class="p-4 p-md-5">
            <div class="status-icon status-icon-error" aria-hidden="true">!</div>
            <h1 id="error-title" class="page-title">&#304;&#351;lem tamamlanamad&#305;</h1>
            <p class="page-description mx-auto mb-4">Beklenmeyen bir hata olu&#351;tu. L&#252;tfen yeniden deneyin veya ana sayfan&#305;za d&#246;n&#252;n.</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">Referans: <code>@Model.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya d&#246;n</a>
        </div>
    </section>
</div>
