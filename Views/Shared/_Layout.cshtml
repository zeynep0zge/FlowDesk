@using FlowDesk.Constants
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }

    bool hasSidebar = User.IsInRole(AppRoles.DepartmentManager);

    string displayName = currentUser?.FullName
        ?? User.Identity?.Name
        ?? "Kullanıcı";

    string roleLabel = User.IsInRole(AppRoles.ProjectManager)
        ? "İş Birimi"
        : User.IsInRole(AppRoles.Analyst)
            ? "Analist"
            : User.IsInRole(AppRoles.DepartmentManager)
                ? "Departman Yöneticisi"
                : User.IsInRole(AppRoles.Employee)
                    ? "Yazılımcı"
                    : "Kullanıcı";

    string homeController = User.IsInRole(AppRoles.ProjectManager)
        ? "ProjectManager"
        : User.IsInRole(AppRoles.Analyst)
            ? "Analyst"
            : User.IsInRole(AppRoles.DepartmentManager)
                ? "DepartmentManager"
                : User.IsInRole(AppRoles.Employee)
                    ? "Employee"
                    : "Home";

    string homeAction = User.IsInRole(AppRoles.Analyst)
        ? "Inbox"
        : User.IsInRole(AppRoles.DepartmentManager)
            ? "Inbox"
            : "Index";

    string userInitial = string.IsNullOrWhiteSpace(displayName)
        ? "K"
        : displayName.Substring(0, 1).ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlowDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlowDesk.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container @(hasSidebar ? "with-sidebar" : "no-sidebar")">
        @if (User.IsInRole(AppRoles.DepartmentManager))
        {
            <aside class="app-sidebar" id="sidebarMenu">
                <div class="sidebar-header">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 17L12 22L22 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 12L12 17L22 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sidebar-logo-text">FlowDesk</span>
                </div>

                <partial name="_DepartmentManagerSidebar" />

                <div class="sidebar-footer text-center">
                    <small>FlowDesk &copy; 2026</small>
                </div>
            </aside>
        }

        <div class="app-content-wrapper">
            <nav class="mobile-nav">
                <a asp-controller="@homeController"
                   asp-action="@homeAction"
                   class="mobile-brand"
                   aria-label="FlowDesk Ana Sayfa">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 17L12 22L22 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 12L12 17L22 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>FlowDesk</span>
                </a>

                @if (hasSidebar)
                {
                    <button class="mobile-nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <line x1="3" y1="12" x2="21" y2="12" />
                            <line x1="3" y1="18" x2="21" y2="18" />
                        </svg>
                    </button>
                }
            </nav>

            <header class="app-header">
                <div class="header-navigation">
                    <a asp-controller="@homeController"
                       asp-action="@homeAction"
                       class="header-brand"
                       aria-label="FlowDesk Ana Sayfa">
                        <svg width="25" height="25" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>FlowDesk</span>
                    </a>

                    <a asp-controller="@homeController"
                       asp-action="@homeAction"
                       class="header-home-link">Ana Sayfa</a>

                    <span class="header-page-title">@ViewData["Title"]</span>
                </div>

                <div class="header-user-area">
                    <div class="user-badge">
                        <div class="user-avatar">@userInitial</div>
                        <div class="d-flex flex-column text-start">
                            <span class="user-name">@displayName</span>
                            <span class="user-role">@roleLabel</span>
                        </div>
                    </div>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="header-logout-button">Çıkış</button>
                        </form>
                    }
                </div>
            </header>

            <main class="app-body">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="container-fluid">
                    FlowDesk İş Takip Sistemi &copy; 2026 -
                    <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Gizlilik Politikası</a>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toggleBtn = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("sidebarMenu");

            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function (event) {
                    sidebar.classList.toggle("show");
                    event.stopPropagation();
                });

                document.addEventListener("click", function (event) {
                    if (window.innerWidth < 992 &&
                        sidebar.classList.contains("show") &&
                        !sidebar.contains(event.target) &&
                        event.target !== toggleBtn) {
                        sidebar.classList.remove("show");
                    }
                });
            }

            var normalizePath = function (value) {
                var normalized = value.toLowerCase().replace(/\/+$/, "");
                return normalized || "/";
            };

            var currentPath = normalizePath(window.location.pathname);
            var activeLink = null;
            var bestMatchLength = -1;

            document.querySelectorAll(".sidebar-link[href]").forEach(function (link) {
                link.classList.remove("active");

                var linkPath = normalizePath(new URL(link.href).pathname);
                var matchLength = -1;

                if (currentPath === linkPath ||
                    (linkPath !== "/" && currentPath.startsWith(linkPath + "/"))) {
                    matchLength = linkPath.length;
                }

                if (matchLength > bestMatchLength) {
                    activeLink = link;
                    bestMatchLength = matchLength;
                }
            });

            if (activeLink) {
                activeLink.classList.add("active");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
