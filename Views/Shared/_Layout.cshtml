@using FlowDesk.Constants
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool hasSidebar = User.IsInRole(AppRoles.DepartmentManager);

    var currentUser = isAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;

    string displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? currentUser.FullName
        : User.Identity?.Name ?? "Kullanıcı";

    string roleDisplayName =
        User.IsInRole(AppRoles.ProjectManager) ? "İş Birimi" :
        User.IsInRole(AppRoles.Analyst) ? "Analist" :
        User.IsInRole(AppRoles.DepartmentManager) ? "Departman Yöneticisi" :
        User.IsInRole(AppRoles.Employee) ? "Yazılımcı" :
        string.Empty;

    string dashboardController =
        User.IsInRole(AppRoles.ProjectManager) ? "ProjectManager" :
        User.IsInRole(AppRoles.Analyst) ? "Analyst" :
        User.IsInRole(AppRoles.DepartmentManager) ? "DepartmentManager" :
        User.IsInRole(AppRoles.Employee) ? "Employee" :
        isAuthenticated ? "Home" : "Account";

    string dashboardAction = isAuthenticated ? "Index" : "Login";
    string userInitial = string.IsNullOrWhiteSpace(displayName)
        ? "K"
        : displayName[..1].ToUpperInvariant();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlowDesk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlowDesk.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- Sidebar yalnızca DepartmentManager rolü için render edilir. -->
        @if (hasSidebar)
        {
            <partial name="_DepartmentManagerSidebar" />
        }

        <!-- Main Content Area -->
        <div class="app-content-wrapper @(hasSidebar ? string.Empty : "no-sidebar")">
            <!-- Mobile Navigation Header -->
            <nav class="mobile-nav">
                <a asp-controller="@dashboardController"
                   asp-action="@dashboardAction"
                   class="d-flex align-items-center gap-2 text-decoration-none">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 17L12 22L22 17" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M2 12L12 17L22 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="fw-bold text-white" style="font-size: 1rem; letter-spacing: 0.05em;">FlowDesk</span>
                </a>
                @if (hasSidebar)
                {
                    <button class="mobile-nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    </button>
                }
            </nav>

            <!-- Main Header -->
            <header class="app-header">
                <div class="header-title-area">
                    <a asp-controller="@dashboardController"
                       asp-action="@dashboardAction"
                       class="header-brand"
                       aria-label="FlowDesk ana sayfa">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>FlowDesk</span>
                    </a>

                    <a asp-controller="@dashboardController"
                       asp-action="@dashboardAction"
                       class="header-home-link">
                        Ana sayfa
                    </a>

                    <h5 class="header-page-title mb-0 text-dark fw-bold">
                        @ViewData["Title"]
                    </h5>
                </div>

                <div class="header-user-area">
                    @if (isAuthenticated)
                    {
                        <div class="user-badge">
                            <div class="user-avatar" aria-hidden="true">
                                @userInitial
                            </div>
                            <div class="d-flex flex-column text-start">
                                <span class="user-name">@displayName</span>
                                <span class="user-role">@roleDisplayName</span>
                            </div>
                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0">
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                Çıkış yap
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-primary btn-sm">
                            Giriş yap
                        </a>
                    }
                </div>
            </header>

            <!-- Page Body -->
            <main class="app-body">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <div class="container-fluid">
                    FlowDesk İş Takip Sistemi &copy; 2026 - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color: var(--primary-navy); font-weight: 500;">Gizlilik Politikası</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Toggling sidebar on mobile
            var toggleBtn = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("sidebarMenu");
            
            if (toggleBtn && sidebar) {
                toggleBtn.addEventListener("click", function (e) {
                    sidebar.classList.toggle("show");
                    e.stopPropagation();
                });
                
                document.addEventListener("click", function (e) {
                    if (window.innerWidth < 992 && sidebar.classList.contains("show") && !sidebar.contains(e.target) && e.target !== toggleBtn) {
                        sidebar.classList.remove("show");
                    }
                });
            }

            // Highlighting active sidebar link
            var normalizePath = function (path) {
                var normalizedPath = path.toLowerCase().replace(/\/+$/, "");
                return normalizedPath || "/";
            };

            var currentPath = normalizePath(window.location.pathname);
            var sidebarLinks = document.querySelectorAll(".sidebar-link");
            var activeLink = null;
            var bestMatchLength = -1;

            sidebarLinks.forEach(function (link) {
                var href = link.getAttribute("href");

                link.classList.remove("active");

                if (href && href !== "#") {
                    var linkPath = normalizePath(new URL(link.href).pathname);
                    var matchLength = -1;

                    if (currentPath === linkPath ||
                        (linkPath !== "/" &&
                         currentPath.startsWith(linkPath + "/"))) {
                        matchLength = linkPath.length;
                    } else if (linkPath !== "/") {
                        var linkSection = "/" + linkPath.split("/")[1];
                        var currentSection = "/" + currentPath.split("/")[1];

                        if (linkSection === currentSection) {
                            matchLength = linkSection.length;
                        }
                    }

                    if (matchLength > bestMatchLength) {
                        activeLink = link;
                        bestMatchLength = matchLength;
                    }
                }
            });

            if (activeLink) {
                activeLink.classList.add("active");
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
