@model FlowDesk.ViewModels.DepartmentManager.ManagerReviewViewModel

@{ ViewData["Title"] = "Talep \u0130nceleme"; }

<div class="container-fluid p-0">
    <header class="page-header">
        <div>
            <h1>Talep &#304;nceleme</h1>
            <p class="page-description"><strong>@Model.RequestNumber</strong> numaral&#305; talebin analiz bilgilerini ve atamalar&#305;n&#305; inceleyin.</p>
        </div>
        <div class="page-actions"><a asp-action="Inbox" class="btn btn-secondary">Onay kutusuna d&#246;n</a></div>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="modern-card" aria-labelledby="manager-request-title">
                <div class="modern-card-header">
                    <h2 id="manager-request-title" class="modern-card-title">Talep ve analiz bilgileri</h2>
                    <partial name="_WorkflowStatusBadge" model="Model.WorkflowStatus" />
                </div>
                <div class="p-4">
                    <div class="detail-grid">
                        <div class="detail-item"><div class="detail-label">Talep No</div><div class="detail-value">@Model.RequestNumber</div></div>
                        <div class="detail-item"><div class="detail-label">Departman</div><div class="detail-value">@Model.Department</div></div>
                        <div class="detail-item"><div class="detail-label">&#214;ncelik</div><div class="detail-value"><partial name="_PriorityBadge" model="Model.Priority" /></div></div>
                        <div class="detail-item"><div class="detail-label">Analist</div><div class="detail-value">@(string.IsNullOrWhiteSpace(Model.AnalystDisplayName) ? "-" : Model.AnalystDisplayName)</div></div>
                        <div class="detail-item"><div class="detail-label">Yaz&#305;l&#305;mc&#305;</div><div class="detail-value">@(string.IsNullOrWhiteSpace(Model.DeveloperDisplayName) ? "-" : Model.DeveloperDisplayName)</div></div>
                        <div class="detail-item"><div class="detail-label">S&#252;r&#252;m Tarihi</div><div class="detail-value">@(Model.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</div></div>
                        <div class="detail-item"><div class="detail-label">Teslim Tarihi</div><div class="detail-value">@(Model.BanksoftDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</div></div>
                        <div class="detail-item"><div class="detail-label">Beklenen Stat&#252;</div><div class="detail-value">@(Model.ExpectedStatus ?? "-")</div></div>
                        <div class="detail-item"><div class="detail-label">Mevcut Stat&#252;</div><div class="detail-value">@(Model.CurrentStatus ?? "-")</div></div>
                    </div>
                    <div class="mt-4"><h3 class="h6 fw-bold">Orijinal Talep A&#231;&#305;klamas&#305;</h3><div class="detail-note">@Model.RequestDescription</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.AiEditedRequest))
                    {
                        <div class="mt-4"><h3 class="h6 fw-bold">Kay&#305;tl&#305; AI Talep D&#252;zenlemesi</h3><div class="detail-note">@Model.AiEditedRequest</div></div>
                    }
                    <div class="mt-4"><h3 class="h6 fw-bold">Analist Notu</h3><div class="detail-note">@(Model.AnalystNote ?? "Analist notu bulunmuyor.")</div></div>
                    <div class="mt-4"><h3 class="h6 fw-bold">Y&#246;netici Notu</h3><div class="detail-note">@(Model.ManagerNote ?? "Yönetici notu bulunmuyor.")</div></div>
                </div>
            </section>
        </div>

        <div class="col-lg-5">
            <section class="form-card" aria-labelledby="manager-decision-title">
                <h2 id="manager-decision-title" class="form-title">Y&#246;netici karar&#305;</h2>
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="developerId" class="form-label">Yaz&#305;l&#305;mc&#305;</label>
                        <select id="developerId" name="DeveloperId" class="form-select">
                            <option value="">Yaz&#305;l&#305;mc&#305; se&#231;in</option>
                            @foreach (var developer in Model.DeveloperOptions)
                            {
                                <option value="@developer.Id" selected="@(Model.DeveloperId == developer.Id)">@developer.DisplayText</option>
                            }
                        </select>
                        <div class="form-text">Onay i&#351;leminde yaz&#305;l&#305;mc&#305; se&#231;imi zorunludur.</div>
                    </div>
                    <div class="mb-3">
                        <label for="managerNote" class="form-label">Y&#246;netici Notu</label>
                        <textarea id="managerNote" name="ManagerNote" class="form-control" rows="7" maxlength="1000" placeholder="Onay veya iade a&#231;&#305;klamas&#305;n&#305; yaz&#305;n.">@Model.ManagerNote</textarea>
                        <div class="form-text">Analiste iade i&#351;leminde y&#246;netici notu zorunludur.</div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" formaction="@Url.Action("Approve", "DepartmentManager", new { id = Model.Id })" class="btn btn-success">Talebi Onayla</button>
                        <button type="submit" formaction="@Url.Action("ReturnToAnalyst", "DepartmentManager", new { id = Model.Id })" class="btn btn-danger">Analiste &#304;ade Et</button>
                        <button type="submit" formaction="@Url.Action("Reject", "DepartmentManager", new { id = Model.Id })" class="btn btn-outline-danger">Talebi Reddet</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>
