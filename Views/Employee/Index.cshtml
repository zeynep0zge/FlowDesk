@model IEnumerable<FlowDesk.Models.WorkItem>
@using FlowDesk.Models

@{
    ViewData["Title"] = "Atanan Isler";
    List<WorkItem> workItems = Model?.ToList() ?? [];

    string PriorityText(RequestPriority priority) => priority switch
    {
        RequestPriority.Low => "Dusuk",
        RequestPriority.Normal => "Normal",
        RequestPriority.High => "Yuksek",
        RequestPriority.Critical => "Kritik",
        _ => priority.ToString()
    };

    string StatusText(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Submitted => "Gonderildi",
        WorkflowStatus.UnderAnalystReview => "Analist Incelemesinde",
        WorkflowStatus.WaitingManagerApproval => "Yonetici Onayinda",
        WorkflowStatus.ReturnedToAnalyst => "Analiste Iade Edildi",
        WorkflowStatus.Approved => "Onaylandi",
        WorkflowStatus.Assigned => "Atandi",
        WorkflowStatus.InProgress => "Devam Ediyor",
        WorkflowStatus.Completed => "Tamamlandi",
        WorkflowStatus.Rejected => "Reddedildi",
        _ => status.ToString()
    };
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--primary-navy);">
                Bana Atanan Isler
            </h2>
            <p class="text-muted mb-0">
                Yalnizca size atanan talepler burada goruntulenir.
            </p>
        </div>
        <span class="badge bg-primary fs-6">@workItems.Count kayit</span>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <section class="modern-card">
        @if (workItems.Count == 0)
        {
            <div class="empty-state p-5 text-center">
                <h3 class="empty-state-title">Atanmis is bulunmuyor</h3>
                <p class="empty-state-description mb-0">
                    Size bir talep atandiginda bu ekranda gorunecektir.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Talep No</th>
                            <th>Departman</th>
                            <th>Oncelik</th>
                            <th>Durum</th>
                            <th>Guncellenme</th>
                            <th class="text-end">Detay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (WorkItem item in workItems)
                        {
                            <tr>
                                <td class="fw-semibold">@item.RequestNumber</td>
                                <td>@item.Department</td>
                                <td>@PriorityText(item.Priority)</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @StatusText(item.WorkflowStatus)
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    @((item.UpdatedAt ?? item.CreatedAt)
                                        .ToLocalTime()
                                        .ToString("dd.MM.yyyy HH:mm"))
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Employee"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Goruntule
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
