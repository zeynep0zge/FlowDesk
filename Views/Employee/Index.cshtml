@model IEnumerable<FlowDesk.Models.WorkItem>
@using FlowDesk.Models

@{
    ViewData["Title"] = "Atanan \u0130\u015fler";
    var workItems = Model?.ToList() ?? new List<WorkItem>();
}

<div class="container-fluid p-0">
    <header class="page-header">
        <div>
            <h1>Atanan &#304;&#351;ler</h1>
            <p class="page-description">Size atanan i&#351;leri ve g&#252;ncel durumlar&#305;n&#305; salt okunur olarak takip edin.</p>
        </div>
        <span class="badge-pill-custom badge-status-neutral">@workItems.Count kay&#305;t</span>
    </header>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }

    <section class="modern-card" aria-labelledby="assigned-work-title">
        <div class="modern-card-header">
            <h2 id="assigned-work-title" class="modern-card-title">&#304;&#351; listesi</h2>
        </div>
        @if (!workItems.Any())
        {
            <div class="empty-state">
                <div class="empty-state-icon" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <h3 class="empty-state-title">Atanm&#305;&#351; i&#351; bulunmuyor</h3>
                <p class="empty-state-description mb-0">Bir talep size atand&#305;&#287;&#305;nda burada g&#246;r&#252;nt&#252;lenecek.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Talep No</th>
                            <th>Departman</th>
                            <th>&#214;ncelik</th>
                            <th>Durum</th>
                            <th>G&#252;ncellenme</th>
                            <th class="text-end">&#304;&#351;lem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (WorkItem item in workItems)
                        {
                            <tr>
                                <td class="fw-semibold">@item.RequestNumber</td>
                                <td>@item.Department</td>
                                <td><partial name="_PriorityBadge" model="item.Priority" /></td>
                                <td><partial name="_WorkflowStatusBadge" model="item.WorkflowStatus" /></td>
                                <td class="text-nowrap">@((item.UpdatedAt ?? item.CreatedAt).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                                <td class="text-end">
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">G&#246;r&#252;nt&#252;le</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
