@model FlowDesk.Models.WorkItem
@using FlowDesk.Models

@{
    ViewData["Title"] = "Is Detayi";

    string PriorityText(RequestPriority priority) => priority switch
    {
        RequestPriority.Low => "Dusuk",
        RequestPriority.Normal => "Normal",
        RequestPriority.High => "Yuksek",
        RequestPriority.Critical => "Kritik",
        _ => priority.ToString()
    };

    string StatusText(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Submitted => "Gonderildi",
        WorkflowStatus.UnderAnalystReview => "Analist Incelemesinde",
        WorkflowStatus.WaitingManagerApproval => "Yonetici Onayinda",
        WorkflowStatus.ReturnedToAnalyst => "Analiste Iade Edildi",
        WorkflowStatus.Approved => "Onaylandi",
        WorkflowStatus.Assigned => "Atandi",
        WorkflowStatus.InProgress => "Devam Ediyor",
        WorkflowStatus.Completed => "Tamamlandi",
        WorkflowStatus.Rejected => "Reddedildi",
        _ => status.ToString()
    };
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--primary-navy);">
                Is Detayi
            </h2>
            <p class="text-muted mb-0">Talep No: @Model.RequestNumber</p>
        </div>
        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Atanan Islere Don
        </a>
    </div>

    <section class="modern-card p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="small text-muted">Talep No</div>
                <div class="fw-semibold">@Model.RequestNumber</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Departman</div>
                <div class="fw-semibold">@Model.Department</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Oncelik</div>
                <div>@PriorityText(Model.Priority)</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Workflow Durumu</div>
                <div>
                    <span class="badge bg-light text-dark border">
                        @StatusText(Model.WorkflowStatus)
                    </span>
                </div>
            </div>
            <div class="col-12">
                <div class="small text-muted">Talep Aciklamasi</div>
                <div class="border rounded bg-light p-3">
                    @Model.RequestDescription
                </div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Beklenen Durum</div>
                <div>@(Model.ExpectedStatus ?? "-")</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Mevcut Durum</div>
                <div>@Model.CurrentStatus</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Surum Tarihi</div>
                <div>@(Model.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Teslim Tarihi</div>
                <div>@(Model.BanksoftDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</div>
            </div>
            <div class="col-12">
                <div class="small text-muted">Analist Notu</div>
                <div class="border rounded bg-light p-3">
                    @(Model.AnalystNote ?? "Not bulunmuyor.")
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ManagerNote))
            {
                <div class="col-12">
                    <div class="small text-muted">Yonetici Notu</div>
                    <div class="border rounded bg-light p-3">
                        @Model.ManagerNote
                    </div>
                </div>
            }
            <div class="col-md-6">
                <div class="small text-muted">Olusturulma</div>
                <div>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Son Guncelleme</div>
                <div>
                    @(Model.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")
                </div>
            </div>
        </div>
    </section>
</div>
