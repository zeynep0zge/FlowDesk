@model FlowDesk.Models.WorkItem

@{
    ViewData["Title"] = "\u0130\u015f Detay\u0131";
}

<div class="container-fluid p-0">
    <header class="page-header">
        <div>
            <h1>&#304;&#351; Detay&#305;</h1>
            <p class="page-description">Talep No: <strong>@Model.RequestNumber</strong> &middot; Bu ekran salt okunurdur.</p>
        </div>
        <div class="page-actions">
            <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Atanan i&#351;lere d&#246;n</a>
        </div>
    </header>

    <section class="modern-card" aria-labelledby="work-summary-title">
        <div class="modern-card-header">
            <h2 id="work-summary-title" class="modern-card-title">Talep &#246;zeti</h2>
            <partial name="_WorkflowStatusBadge" model="Model.WorkflowStatus" />
        </div>
        <div class="p-4">
            <div class="detail-grid">
                <div class="detail-item"><div class="detail-label">Talep No</div><div class="detail-value">@Model.RequestNumber</div></div>
                <div class="detail-item"><div class="detail-label">Departman</div><div class="detail-value">@Model.Department</div></div>
                <div class="detail-item"><div class="detail-label">&#214;ncelik</div><div class="detail-value"><partial name="_PriorityBadge" model="Model.Priority" /></div></div>
                <div class="detail-item"><div class="detail-label">Mevcut Stat&#252;</div><div class="detail-value">@Model.CurrentStatus</div></div>
                <div class="detail-item"><div class="detail-label">Beklenen Stat&#252;</div><div class="detail-value">@(Model.ExpectedStatus ?? "-")</div></div>
                <div class="detail-item"><div class="detail-label">S&#252;r&#252;m Tarihi</div><div class="detail-value">@(Model.ReleaseDate?.ToString("dd.MM.yyyy") ?? "-")</div></div>
                <div class="detail-item"><div class="detail-label">Teslim Tarihi</div><div class="detail-value">@(Model.BanksoftDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</div></div>
                <div class="detail-item"><div class="detail-label">Son G&#252;ncelleme</div><div class="detail-value">@(Model.UpdatedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</div></div>
            </div>

            <div class="mt-4">
                <h3 class="h6 fw-bold">Talep A&#231;&#305;klamas&#305;</h3>
                <div class="detail-note">@Model.RequestDescription</div>
            </div>
            <div class="mt-4">
                <h3 class="h6 fw-bold">Analist Notu</h3>
                <div class="detail-note">@(Model.AnalystNote ?? "Not bulunmuyor.")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ManagerNote))
            {
                <div class="mt-4">
                    <h3 class="h6 fw-bold">Y&#246;netici Notu</h3>
                    <div class="detail-note">@Model.ManagerNote</div>
                </div>
            }
        </div>
    </section>
</div>
